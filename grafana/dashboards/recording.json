  "panels": [
    {
      "id": 10,
      "title": "Persistent Recording Is Unavailable in o-sfu b60da1d5",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "The checked server revision disables the persistent recording backend and rejects room recording start and stop controls. Recording feature flags do not enable a storage backend.\n\nThis is a source-verified support statement for revision **b60da1d5**, not a runtime capability probe. The charts below show handled room controls. They do not establish media capture, artifact creation or upload success."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      }
    },
    {
      "datasource": "Prometheus",
      "description": "Start and stop controls that reached room recording handlers during the last five minutes. Earlier protocol or permission rejections are outside this counter.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 4
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (increase(osfu_recording_actions_total{instance=~\"$instance\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "{{instance}} handled controls",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Handled Recording Controls / 5m",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Room start and stop controls rejected during the last five minutes. Rejection is expected while the persistent recording backend is unavailable.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 4
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance, action) (increase(osfu_recording_actions_total{instance=~\"$instance\",outcome=\"rejected\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "{{instance}} {{action}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Rejected Recording Controls / 5m",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Room recording control rates by action and outcome. Accepted/capture counters remain inactive at the checked server revision and are not storage health signals.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
