        "y": 10,
        "w": 24,
        "h": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "(sum by (instance, action, outcome) (rate(osfu_recording_actions_total{instance=~\"$instance\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "{{instance}} {{action}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Room Recording Control Outcomes",
      "type": "timeseries",
      "options": {
