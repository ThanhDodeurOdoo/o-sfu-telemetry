    {
      "id": 10,
      "title": "Local forwards per ingress packet",
      "type": "stat",
      "description": "Fanout multiplicity can exceed one. It is not packet-delivery efficiency. Zero ingress has no defined ratio.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 27,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:x",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
