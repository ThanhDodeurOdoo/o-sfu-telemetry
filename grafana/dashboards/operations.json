  "panels": [
    {
      "id": 1,
      "title": "Alert state",
      "type": "stat",
      "description": "No firing alerts is shown only with fresh SFU metrics and successful probes. Unverified means those observations are unavailable.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unverified",
                  "color": "#8E8E8E"
                },
                "1": {
                  "text": "No firing alerts",
                  "color": "green"
                },
                "2": {
                  "text": "Warning",
                  "color": "orange"
                },
                "3": {
                  "text": "Critical",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "",
          "expr": "osfu:operator_alert_status{instance=~\"$instance\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Metrics scrape",
      "type": "stat",
