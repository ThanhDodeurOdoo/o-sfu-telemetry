    {
      "id": 13,
      "title": "Current room users",
      "type": "stat",
      "description": "Room users include sessions still establishing their RTC transport.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "",
          "expr": "(sum by (instance) (osfu_users_active{instance=~\"$instance\"})) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Observed boundaries",
      "type": "state-timeline",
      "description": "Each boundary is evaluated independently. Admission and ICE/DTLS need at least 15 relevant events in five minutes. A threshold breach is evidence to investigate, not an identified root cause.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 14,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                },
                "0": {
                  "text": "Insufficient activity",
                  "color": "#8E8E8E"
                },
                "1": {
                  "text": "No threshold breach",
                  "color": "green"
                },
                "2": {
                  "text": "Degraded",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{boundary}}",
          "expr": "osfu:operator_boundary_status{instance=~\"$instance\"}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "links": [
        {
          "title": "Inspect control plane",
          "url": "/d/osfu-control-plane?from=${__from}&to=${__to}&${instance:queryparam}",
          "targetBlank": false
        },
        {
          "title": "Inspect transport",
          "url": "/d/osfu-transport-lifecycle?from=${__from}&to=${__to}&${instance:queryparam}",
          "targetBlank": false
        },
        {
          "title": "Inspect media",
          "url": "/d/osfu-media-path?from=${__from}&to=${__to}&${instance:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Pending and firing alerts",
      "type": "table",
      "description": "Pending alerts have not reached their hold duration. An empty table means no matching alerts, not proof of healthy telemetry.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 14,
        "y": 10,
        "w": 10,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ],
          "custom": {
            "wrapText": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "",
          "expr": "ALERTS{instance=~\"$instance\",alertname=~\"OSFU.*\",alertstate=~\"pending|firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "links": [
        {
          "title": "Inspect warning and error logs",
          "url": "/d/osfu-log-health?from=${__from}&to=${__to}",
          "targetBlank": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value": true,
              "instance": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "alertstate": 2
            },
            "renameByName": {
              "severity": "Severity",
              "alertname": "Alert",
              "alertstate": "State"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Connection events in the last 5 minutes",
      "type": "timeseries",
      "description": "Rolling event counts share one window. Retries, reconnects and window boundaries mean these are not matched session cohorts.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "accepted",
          "expr": "osfu:ws_accepted_events_5m{instance=~\"$instance\"}"
        },
        {
          "refId": "B",
          "legendFormat": "credentials",
          "expr": "osfu:ws_credentials_received_events_5m{instance=~\"$instance\"}"
        },
        {
          "refId": "C",
          "legendFormat": "joined",
          "expr": "osfu:ws_joined_events_5m{instance=~\"$instance\"}"
        },
        {
          "refId": "D",
          "legendFormat": "DTLS connected",
          "expr": "(sum by (instance) (increase(osfu_transport_dtls_connected_total{instance=~\"$instance\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Media throughput",
      "type": "timeseries",
      "description": "Forwarding counts one operation per destination. Receive-only calls and policy-selected layers can legitimately have different ingress and forwarding rates.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
