  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Investigate",
      "type": "dashboards",
      "tags": [
        "o-sfu"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Canary Comparison",
      "type": "link",
      "url": "/d/osfu-staging-canary/o-sfu-staging-canary?orgId=1&from=${__from}&to=${__to}&var-candidate_instance=${instance:percentencode}"
    },
    {
      "title": "Control Plane",
      "type": "link",
      "url": "/d/osfu-control-plane/o-sfu-control-plane?orgId=1&from=${__from}&to=${__to}&${instance:queryparam}"
