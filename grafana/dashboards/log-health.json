          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "title": "Telemetry process memory",
      "description": "Resident process memory by service. This is memory consumption, not filesystem capacity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
