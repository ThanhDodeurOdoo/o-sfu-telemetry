    {
      "id": 14,
      "title": "Log intake and delivery",
      "description": "Accepted and successfully exported records per second. Export counts can lag intake while batching or retrying. Zero activity alone does not prove application logging is healthy.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (receiver) (rate(otelcol_receiver_accepted_log_records{job=\"otel-collector\"}[5m]))",
          "legendFormat": "accepted {{receiver}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_log_records{job=\"otel-collector\"}[5m]))",
          "legendFormat": "sent {{exporter}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
