    {
      "id": 17,
      "title": "Exporter queue occupancy",
      "description": "Fraction of the configured sending queue in use. Missing series mean the queue is not observed. Queues do not measure free disk space.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "otelcol_exporter_queue_size{job=\"otel-collector\"} / (otelcol_exporter_queue_capacity{job=\"otel-collector\"} > 0)",
          "legendFormat": "{{exporter}} {{data_type}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
