      "description": "Counts all log levels over five minutes independently of the warning filter below. Empty results may mean quiet applications, a broken log source or retention. Check intake, export and readiness above.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 6
