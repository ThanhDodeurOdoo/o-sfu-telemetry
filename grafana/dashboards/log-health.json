  "panels": [
    {
      "id": 10,
      "title": "Prometheus readiness",
      "description": "Requires a fresh successful metrics scrape and readiness probe. This verifies endpoint availability, not end-to-end delivery.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min(up{job=\"prometheus\"} * (time() - timestamp(up{job=\"prometheus\"}) < bool 60)) or vector(0)) * (min(probe_success{job=\"telemetry-readiness\",component=\"prometheus\"} * (time() - timestamp(probe_success{job=\"telemetry-readiness\",component=\"prometheus\"}) < bool 60)) or vector(0)) * (min(up{job=\"telemetry-readiness\",component=\"prometheus\"}) or vector(0))",
          "legendFormat": "Prometheus",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
