      "id": 7,
      "targets": [
        {
          "expr": "(sum by (instance) (rate(osfu_transport_dtls_connected_total{instance=~\"$instance\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "dtls connected/s",
          "refId": "A"
        },
        {
          "expr": "(sum by (instance) (rate(osfu_ws_user_loop_exits_total{instance=~\"$instance\",reason=\"transport_disconnected\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "ws transport exits/s",
          "refId": "B"
        }
      ],
      "title": "DTLS and Transport Disconnects",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
