{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#5794F2",
        "name": "Deployments and incidents",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Current RTC transports whose observed health is connected. This does not prove active media delivery.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (osfu_transport_health_users{instance=~\"$instance\",state=\"connected\"})) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Connected Transports",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Current transports observed as disconnected. Removed sessions leave this gauge and are counted through lifecycle events.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (osfu_transport_health_users{instance=~\"$instance\",state=\"disconnected\"})) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Disconnected Transports",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "The rate at which active connections are failing. Frequent transitions indicate a 'jittery' network or server-side instability.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (rate(osfu_transport_health_transitions_total{instance=~\"$instance\",from=\"connected\",to=\"disconnected\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Disconnect Transitions/s",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "ICE state-change events exported as new, checking, connected, completed and disconnected.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "targets": [
        {
          "expr": "(sum by (instance, state) (rate(osfu_transport_ice_state_changes_total{instance=~\"$instance\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "title": "ICE State Changes",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Observed transport health edges between unset, connected and disconnected.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 5,
      "targets": [
        {
          "expr": "(sum by (instance, from, to) (rate(osfu_transport_health_transitions_total{instance=~\"$instance\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "{{from}} -> {{to}}",
          "refId": "A"
        }
      ],
      "title": "Transport Health Transitions",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Shares among closed RTC sessions in five minutes. Short sessions are a symptom to compare with exit reasons, not a failure classification. No closures means unavailable.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "id": 6,
      "targets": [
        {
          "refId": "A",
          "legendFormat": "at most 10s",
          "expr": "osfu:transport_short_sessions_le10s_ratio_5m{instance=~\"$instance\"}"
        },
        {
          "refId": "B",
          "legendFormat": "at most 60s",
          "expr": "osfu:transport_short_sessions_le60s_ratio_5m{instance=~\"$instance\"}"
        }
      ],
      "title": "Short closed-session share",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": "Prometheus",
      "description": "Independent DTLS-connected events and WebSocket exits attributed to transport disconnection. They are not paired session outcomes.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
