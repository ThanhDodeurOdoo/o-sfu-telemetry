      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Log Health",
      "type": "link",
      "url": "/d/osfu-log-health/o-sfu-log-health?orgId=1&from=${__from}&to=${__to}"
    },
    {
      "title": "Operations",
      "type": "link",
      "url": "/d/osfu-operations/o-sfu-operations?orgId=1&from=${__from}&to=${__to}"
    },
    {
      "title": "Investigate Entered IDs",
      "type": "link",
      "url": "/d/osfu-user-diagnostics/o-sfu-user-diagnostics?orgId=1&from=${__from}&to=${__to}&var-room_id=${room_id:percentencode}&var-user_id=${user_id:percentencode}"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Newest matching logs in the selected interval, limited to 100 lines. Room, user and trace filters are regular expressions with .* matching all values. Expand trace_id to open Tempo. Traces may be unsampled or outside retention. Use this panel's Explore menu action to inspect larger result sets with the current filters and interval. Enter concrete room and user IDs before opening Investigate Entered IDs.",
      "gridPos": {
        "h": 30,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{service_name=\"o-sfu\"} |~ \"(?i)${search:raw}\" | level=~\"${level:pipe}\" | event=~\"${event:raw}\" | target=~\"${target:raw}\" | room_id=~\"${room_id:raw}\" | user_id=~\"(Integer\\\\()?${user_id:raw}(\\\\))?\" | trace_id=~\"${trace_id:raw}\"",
          "maxLines": 100,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "All Logs",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "o-sfu",
    "logs",
    "loki"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "label": "severity",
        "multi": true,
        "name": "level",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "TRACE",
            "value": "TRACE"
          },
          {
            "selected": false,
            "text": "DEBUG",
            "value": "DEBUG"
          },
          {
            "selected": false,
            "text": "INFO",
            "value": "INFO"
          },
          {
            "selected": false,
            "text": "WARN",
            "value": "WARN"
          },
          {
            "selected": false,
            "text": "ERROR",
            "value": "ERROR"
          }
        ],
        "query": "TRACE,DEBUG,INFO,WARN,ERROR",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "label": "event regex",
