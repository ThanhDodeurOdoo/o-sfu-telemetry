{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "The total number of users currently connected to the server. Use this to monitor the overall load and reach of the system.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(osfu_users_active)",
          "refId": "A"
        }
      ],
      "title": "Active Users",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "The number of active HTTP API requests currently being processed by the server, excluding internal telemetry scrapers.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(osfu_http_inflight_requests{route!=\"metrics\"})",
          "refId": "A"
        }
      ],
      "title": "HTTP Inflight",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "A simple health check that verifies if the server basic API is responsive. 1 means the server is responding, 0 means it is likely frozen or down.",
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(probe_success{job=\"o-sfu-noop\"})",
          "refId": "A"
        }
      ],
      "title": "Noop Probe",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "A health check that verifies if the internal diagnostic systems are functioning correctly.",
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "osfu:diagnostics_probe_success",
          "refId": "A"
        }
      ],
      "title": "Diagnostics Probe",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Throughput of HTTP API requests broken down by route endpoint.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "id": 14,
      "targets": [
        {
          "expr": "rate(osfu_http_noop_requests_total[5m])",
          "legendFormat": "noop",
          "refId": "A"
        },
        {
          "expr": "rate(osfu_http_stats_requests_total[5m])",
          "legendFormat": "stats",
          "refId": "B"
        },
        {
          "expr": "rate(osfu_http_room_requests_total[5m])",
          "legendFormat": "room",
          "refId": "C"
        },
        {
          "expr": "rate(osfu_http_disconnect_requests_total[5m])",
          "legendFormat": "disconnect",
          "refId": "D"
        },
        {
          "expr": "rate(osfu_http_metrics_requests_total[5m])",
          "legendFormat": "metrics",
          "refId": "E"
        }
      ],
      "title": "HTTP Requests by Route",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Rate of HTTP responses by status outcome on channel join and disconnect routes.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "id": 15,
      "targets": [
        {
          "expr": "sum by (status) (rate(osfu_http_room_responses_total[5m]))",
          "legendFormat": "room: {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (status) (rate(osfu_http_disconnect_responses_total[5m]))",
          "legendFormat": "disconnect: {{status}}",
          "refId": "B"
        }
      ],
      "title": "HTTP Response Statuses",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Measures how long the server takes to respond to 95% of HTTP requests. Lower is better; sudden spikes indicate performance bottlenecks.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(osfu_http_request_duration_seconds_bucket[10m])))",
          "legendFormat": "{{route}} p95",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Duration p95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Rate of client WebSocket connections progressing through handshake, credentials, and room join stages.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "id": 16,
      "targets": [
        {
          "expr": "sum by (stage) (rate(osfu_ws_connections_total[5m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "title": "WebSocket Connection Stages",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Shows the time it takes for 95% of users to complete the initial connection handshake and authentication. High values lead to a slow feel when joining.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(osfu_ws_handshake_duration_seconds_bucket[10m]))",
          "legendFormat": "handshake p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(osfu_ws_auth_duration_seconds_bucket[10m]))",
          "legendFormat": "auth p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, rate(osfu_ws_user_initialize_duration_seconds_bucket[10m]))",
          "legendFormat": "user init p95",
          "refId": "C"
        }
      ],
      "title": "Websocket Startup Duration p95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Shows why WebSocket connections are being rejected (e.g. wrong credentials or server too busy). Each color represents a different rejection reason.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (close_code) (rate(osfu_ws_handshake_rejections_total[5m]))",
          "legendFormat": "{{close_code}}",
          "refId": "A"
        }
      ],
      "title": "Handshake Rejections by Close Code",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Tracks why active user sessions are ending. Common reasons include client close or heartbeat timeout.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (reason) (rate(osfu_ws_user_loop_exits_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "User Loop Exits by Reason",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "The number of messages waiting to be sent to users browsers. If this grows, it means the server is sending data faster than the users networks can receive it.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "id": 12,
      "targets": [
        {
          "expr": "osfu:ws_outbound_queue_depth",
          "legendFormat": "queued messages",
          "refId": "A"
        }
      ],
      "title": "Websocket Outbound Queue Depth",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "The rate at which the server is forced to disconnect slow users because their message queue became too full. This protects server memory.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "id": 13,
      "targets": [
        {
          "expr": "osfu:ws_outbound_queue_overflow_rate_5m",
          "legendFormat": "overflow rate",
          "refId": "A"
        }
      ],
      "title": "Websocket Outbound Queue Overflow Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "The number of users currently broadcasting their camera, microphone, or screen. This is the Input side of media flow.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 29
      },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(osfu_publications_active)",
          "refId": "A"
        }
      ],
      "title": "Active Publications",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "The number of individual media streams being received by users. This is the Output side and represents bandwidth consumption.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 29
      },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(osfu_subscriptions_active)",
          "refId": "A"
        }
      ],
      "title": "Active Subscriptions",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "A timeline view comparing how many people are broadcasting (publications) versus how many people are watching (subscriptions).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "id": 11,
      "targets": [
        {
          "expr": "sum(osfu_publications_active)",
          "legendFormat": "publications",
          "refId": "A"
        },
        {
          "expr": "sum(osfu_subscriptions_active)",
          "legendFormat": "subscriptions",
          "refId": "B"
        }
      ],
      "title": "Live Media Totals",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Recent HTTP API requests, WebSocket upgrades, handshakes, and terminations from structured logs. Shows client remote IP, route, user ID, status code, and latency.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 17,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{service_name=\"o-sfu\"} |~ \"(?i)http|ws|route|request\" | json",
          "maxLines": 100,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Signaling Access Logs",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "o-sfu",
    "phase-2"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "o-sfu Control Plane",
  "uid": "osfu-control-plane",
  "version": 4,
  "weekStart": ""
}
