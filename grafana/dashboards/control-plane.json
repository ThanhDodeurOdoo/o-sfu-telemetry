    {
      "datasource": "Prometheus",
      "description": "Measures how long the server takes to respond to 95% of HTTP requests. Lower is better; sudden spikes indicate performance bottlenecks.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 7,
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (instance, le, route) (rate(osfu_http_request_duration_seconds_bucket{instance=~\"$instance\"}[10m])))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "{{route}} p95",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Duration p95",
      "type": "timeseries"
    },
