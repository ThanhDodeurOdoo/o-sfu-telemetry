  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Current room users, including sessions establishing RTC transport.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (osfu_users_active{instance=~\"$instance\"})) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Active Users",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "The number of active HTTP API requests currently being processed by the server, excluding internal telemetry scrapers.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (osfu_http_inflight_requests{instance=~\"$instance\",route!=\"metrics\"})) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "HTTP Inflight",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "A simple health check that verifies if the server basic API is responsive. 1 means the server is responding, 0 means it is likely frozen or down.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unavailable",
                  "color": "#8E8E8E"
                },
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Successful",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "osfu:noop_probe_status{instance=~\"$instance\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Noop Probe",
      "type": "stat"
