          "expr": "(sum by (instance, status) (rate(osfu_http_disconnect_responses_total{instance=~\"$instance\"}[5m]))) and on (instance) (osfu:metrics_available{instance=~\"$instance\"} == 1)",
          "legendFormat": "disconnect: {{status}}",
